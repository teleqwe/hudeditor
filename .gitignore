app/webview2/

# Build output (app/CSSHudEditor.exe is kept in the repo as the download)
hudreload/build/
app/build/
*.tmp

# Working notes
PLAN.md

# The HUDs Claude built, kept out of builds (HUD_CREATION_GUIDE.md, section 0)
claude huds/

