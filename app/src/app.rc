// Everything the exe carries. Paths are relative to app/src (build.bat runs rc from there).
// the app's icon (the exe in Explorer, the window, the taskbar): drawn by dev/icon.py
1 ICON "app.ico"
EDITOR     RCDATA "..\..\editor\index.html"
PLUGIN_DLL RCDATA "..\..\hudreload\build\schemereload.dll"
PLUGIN_VDF RCDATA "..\..\hudreload\schemereload.vdf"
CLIENT_DEF RCDATA "..\defaults\clientscheme_default.res"
SOURCE_DEF RCDATA "..\defaults\sourcescheme_default.res"
HUDLAYOUT_DEF RCDATA "..\defaults\hudlayout_default.res"
V_SCOREBOARD RCDATA "../defaults/ui/scoreboard.res"
V_SPECTATOR RCDATA "../defaults/ui/spectator.res"
V_BOTTOMSPECTATOR RCDATA "../defaults/ui/bottomspectator.res"
V_TEAMMENU RCDATA "../defaults/ui/teammenu.res"
V_CLASSMENU_CT RCDATA "../defaults/ui/classmenu_ct.res"
V_CLASSMENU_TER RCDATA "../defaults/ui/classmenu_ter.res"
V_TEXTWINDOW RCDATA "../defaults/ui/textwindow.res"
V_BUYMENU RCDATA "../defaults/ui/buymenu.res"
V_CHATSCHEME RCDATA "../defaults/chatscheme.res"
V_INTERNETGAMESPAGE RCDATA "../defaults/ui/internetgamespage.res"
V_CUSTOMGAMESPAGE RCDATA "../defaults/ui/customgamespage.res"
V_BASECHAT RCDATA "../defaults/ui/basechat.res"
V_LOADINGDIALOGNOBANNER RCDATA "../defaults/ui/loadingdialognobanner.res"
V_LOADINGDIALOGVAC RCDATA "../defaults/ui/loadingdialogvac.res"
V_WIN_ROUND RCDATA "../defaults/ui/win_round.res"
V_FREEZEPANEL_BASIC RCDATA "../defaults/ui/freezepanel_basic.res"
V_C4PANEL RCDATA "../defaults/ui/c4panel.res"
V_BUYMENU_CT RCDATA "../defaults/ui/buymenu_ct.res"
V_BUYMENU_TER RCDATA "../defaults/ui/buymenu_ter.res"
// class select's picture pages (classes/<class>.res: the model, its frame, name and description)
V_URBAN RCDATA "../defaults/ui/classes/urban.res"
V_GSG9 RCDATA "../defaults/ui/classes/gsg9.res"
V_SAS RCDATA "../defaults/ui/classes/sas.res"
V_GIGN RCDATA "../defaults/ui/classes/gign.res"
V_TERROR RCDATA "../defaults/ui/classes/terror.res"
V_LEET RCDATA "../defaults/ui/classes/leet.res"
V_ARCTIC RCDATA "../defaults/ui/classes/arctic.res"
V_GUERILLA RCDATA "../defaults/ui/classes/guerilla.res"
V_AUTOSELECT_CT RCDATA "../defaults/ui/classes/autoselect_ct.res"
V_AUTOSELECT_T RCDATA "../defaults/ui/classes/autoselect_t.res"
// the version (file properties); keep it the same as APP_VERSION in main.cpp
1 VERSIONINFO
FILEVERSION 0,9,1,0
PRODUCTVERSION 0,9,1,0
FILEFLAGSMASK 0x3F
FILEFLAGS 0x2
FILEOS 0x40004
FILETYPE 0x1
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "FileDescription", "Tele HUD Editor"
			VALUE "FileVersion", "0.9.1-beta"
			VALUE "ProductName", "Tele HUD Editor"
			VALUE "ProductVersion", "0.9.1-beta"
			VALUE "LegalCopyright", "Copyright (c) 2026 tele4. MIT License."
			VALUE "OriginalFilename", "CSSHudEditor.exe"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
